{
  "name": "@web-baseline/postcss-wrap-up-layer",
  "version": "0.2.0",
  "description": "PostCSS plugin to add cascade layers to CSS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    },
    "./transform": {
      "import": "./dist/transform.mjs",
      "types": "./dist/transform.d.ts",
      "require": "./dist/transform.cjs"
    }
  },
  "files": [
    "./dist",
    "./src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "postcss",
    "css",
    "css cascade layer",
    "postcss-plugin"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest"
  },
  "license": "MIT",
  "author": "TM-SunnyDay <sunnyday@chongying.studio> (https://github.com/TM-SunnyDay/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-baseline/postcss-wrap-up-layer"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.4.27"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/css": "^0.10.0",
    "@eslint/js": "^9.31.0",
    "@eslint/markdown": "^7.0.0",
    "@stylistic/eslint-plugin": "^5.2.0",
    "@types/node": "^24.0.14",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "postcss": "^8.4.27",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "unbuild": "^3.6.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.12.1"
}
