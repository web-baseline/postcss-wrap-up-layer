{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "src"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  }
}
